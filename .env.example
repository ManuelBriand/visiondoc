# Empreintes SHA-256 des clés API acceptées, séparées par des virgules.
# Générer une clé : docker compose run --rm inference python -m inference.api.keys
VISIONDOC_API_KEY_HASHES=

# Réglages de performance (facultatifs, voir docs/adr/0006) : sur 2 processeurs,
# VISIONDOC_CPU_THREADS=2 est le plus rapide ; VISIONDOC_DET_MAX_SIDE=736 gagne ~20 %
# pour une précision quasi identique.
# VISIONDOC_CPU_THREADS=
# VISIONDOC_DET_MAX_SIDE=
